# .env.example
# Copy this file to .env.local for local development.
# Add every variable below to Vercel:
#   Vercel Dashboard > Your Project > Settings > Environment Variables
#
# NEVER commit .env.local to Git.
# This .env.example file is safe to commit - it contains no real secrets.

# ============================================================
# NEXT.JS
# ============================================================

# The full URL of your site.
# Local: http://localhost:3000
# Production: https://olliedoesis.dev
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign session tokens.
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# ============================================================
# SUPABASE
# ============================================================

# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - has full DB access, NEVER expose to the browser.
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# UPSTASH REDIS (rate limiting)
# Get these from: https://upstash.com
#   1. Sign up free
#   2. Create a Redis database
#   3. Click the database > REST API tab
#   4. Copy the URL and token below
# ============================================================

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================================
# SECURITY
# ============================================================

# Salt used when hashing IP addresses for anonymous vote tracking.
# Generate one: openssl rand -hex 32
# Change this and all existing IP hashes become invalid (votes reset).
IP_HASH_SALT=your-random-salt-here

# ============================================================
# AUTH PROVIDERS (NextAuth)
# ============================================================

# GitHub OAuth
# Create at: https://github.com/settings/applications/new
# Callback URL: https://olliedoesis.dev/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================
# OPTIONAL - ADD LATER
# ============================================================

# Sentry error monitoring (post-launch)
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.sentry.io/...
