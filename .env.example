# .env.example
# Copy this file to .env.local for local development.
# Add every variable below to Vercel:
#   Vercel Dashboard > Your Project > Settings > Environment Variables
#
# NEVER commit .env.local to Git.
# This .env.example file is safe to commit - it contains no real secrets.

# Node Environment (development, production, or test)
NODE_ENV=development

# ==========================================
# NEXT.JS CONFIGURATION
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# AUTHENTICATION (NextAuth v5)
# ==========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth Provider
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==========================================
# DATABASE (Supabase)
# ==========================================
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# RATE LIMITING (Upstash Redis)
# ==========================================
# Get these from: https://upstash.com
#   1. Sign up free
#   2. Create a Redis database
#   3. Click the database > REST API tab
#   4. Copy the URL and token below
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ==========================================
# EMAIL (Resend for magic links)
# ==========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# ==========================================
# SECURITY
# ==========================================
# Salt used when hashing IP addresses for anonymous vote tracking.
# Generate one: openssl rand -hex 32
# Change this and all existing IP hashes become invalid (votes reset).
IP_HASH_SALT=your-random-salt-here
ENCRYPTION_KEY=your-encryption-key

# ==========================================
# OPTIONAL - ADD LATER
# ==========================================
# Sentry error monitoring (post-launch)
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.sentry.io/...